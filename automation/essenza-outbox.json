{
  "name": "Essenza - local synthetic outbox",
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/outbox/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "claim",
      "name": "Claim event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e=$input.first().json.event; if(!e)return []; return [{json:{id:e.id,lease:e.lease,success:true,simulation:'No notification sent'}}];"
      },
      "id": "simulate",
      "name": "Simulate notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/outbox/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { id: $json.id, lease: $json.lease, success: $json.success } }}",
        "options": {}
      },
      "id": "ack",
      "name": "Acknowledge event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Claim event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim event": {
      "main": [
        [
          {
            "node": "Simulate notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Simulate notification": {
      "main": [
        [
          {
            "node": "Acknowledge event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
